staging.freshr.cc {
	reverse_proxy frontend-staging:80 {
		transport http {
            dial_timeout 30s
            response_header_timeout 300s
        }
	}
}

freshr.cc, www.freshr.cc {
	reverse_proxy frontend-prod:80 {
		transport http {
            dial_timeout 30s
            response_header_timeout 300s
        }
	}
}

# Dozzle log viewer. Auth is handled by Dozzle itself (DOZZLE_AUTH_PROVIDER=simple,
# users defined in /opt/freshr/dozzle/users.yml on the VPS). Caddy just terminates
# TLS and forwards to the dozzle service over the `edge` network.
logs.freshr.cc {
	reverse_proxy dozzle:8080
}